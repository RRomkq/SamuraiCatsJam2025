--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 67431e63601e44edbfbf7726f649ec43, type: 3}
  m_Name: SpeechSO
  m_EditorClassIdentifier: 
  m_speechReplics:
  - m_speechSituation: 0
    m_speechReplics:
    - "\u041A\u0442\u043E \u043A\u0440\u0430\u0439\u043D\u0438\u0439?"
    - "\u041E\u0439, \u0430 \u044F \u0443\u0436\u0435 \u0442\u0443\u0442 \u0437\u0430\u043D\u0438\u043C\u0430\u043B!"
    - "\u041C\u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C!"
    - "\u041C\u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C!"
    - "\u041C\u043E\u0436\u043D\u043E \u0441\u043A\u0438\u0434\u043A\u0443 \u043F\u043E
      \u0441\u0442\u0443\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u043E\u043C\u0443?"
    - "\u042F \u0443\u043C\u0435\u0440 \u0432 \u0442\u0430\u043F\u043A\u0430\u0445.
      \u0413\u0434\u0435 \u043C\u043E\u0438 \u0442\u0430\u043F\u043A\u0438?"
    - "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u0435\u0449\u0451 \u0436\u0434\u0430\u0442\u044C?"
    - "\u042F \u0443\u043C\u0435\u0440 \u043E\u0442 \u0434\u0438\u0435\u0442\u044B.
      \u0413\u0434\u0435 \u0442\u0443\u0442 \u0431\u0443\u0444\u0435\u0442?"
    - "\u042F \u0443\u043C\u0435\u0440 \u043E\u0442 \u043F\u0430\u0434\u0435\u043D\u0438\u044F.
      \u0413\u0434\u0435 \u0436\u0430\u043B\u043E\u0431\u043D\u0430\u044F \u043A\u043D\u0438\u0433\u0430
      \u043D\u0430 \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044E?"
    - "\u042F \u0443\u043C\u0435\u0440 \u043D\u0438 \u0437\u0430 \u0447\u0442\u043E.
      \u0422\u0435\u043F\u0435\u0440\u044C \u043C\u043D\u0435 \u0435\u0449\u0451
      \u0438 \u043F\u043B\u0430\u0442\u0438\u0442\u044C?!"
    - "\u0427\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C, \u0435\u0441\u043B\u0438
      \u043C\u043E\u0439 \u043A\u043E\u0442 \u0442\u043E\u0436\u0435 \u0443\u043C\u0435\u0440
      \u0438 \u043D\u0435 \u0438\u0434\u0451\u0442 \u0441\u043E \u043C\u043D\u043E\u0439?"
    - "\u042F \u043D\u0435 \u043F\u043E\u0435\u0434\u0443 \u0431\u0435\u0437 \u043C\u0443\u0437\u044B\u043A\u0438
      80-\u0445!"
    - "\u0421\u043F\u043E\u0439 \u043C\u043D\u0435 \u043F\u0435\u0441\u043D\u044E
      \u0438\u043B\u0438 \u044F \u043D\u0435 \u043F\u043E\u0435\u0434\u0443!"
    - "\u0421\u043B\u0443\u0448\u0430\u0439\u0442\u0435, \u0430 \u0435\u0441\u0442\u044C
      \u0441\u043A\u0438\u0434\u043A\u0438 \u0434\u043B\u044F \u0434\u0443\u0448,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0447\u0442\u043E \u0443\u043C\u0435\u0440\u043B\u0438?"
    - "\u0410 \u0447\u0442\u043E \u0435\u0441\u043B\u0438 \u044F \u043F\u0440\u043E\u0441\u0442\u043E
      \u0437\u0430\u043F\u043B\u0430\u0447\u0443 \u0442\u0435\u0431\u0435 \u0438
      \u043F\u043E\u0439\u0434\u0443 \u043A\u0443\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C?"
    - "\u041C\u043E\u0433\u0443 \u043B\u0438 \u044F \u043E\u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u0447\u0435\u0440\u0435\u0437 \u0434\u0443\u0448\u0443?"
    - "\u0415\u0441\u043B\u0438 \u044F \u043D\u0435 \u043C\u043E\u0433\u0443 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u0437\u0430 \u043F\u0440\u043E\u0435\u0437\u0434, \u044D\u0442\u043E \u0431\u0443\u0434\u0435\u0442
      \u0441\u0447\u0438\u0442\u0430\u0442\u044C\u0441\u044F \u043A\u0430\u0440\u043C\u043E\u0439?"
    - "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u0435\u0449\u0435 \u0436\u0434\u0430\u0442\u044C?
      \u042F \u0436\u0435 \u0443\u0436\u0435 \u043C\u0435\u0440\u0442\u0432\u044B\u0439!"
    - "\u0413\u0434\u0435 \u0442\u0443\u0442 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u0430\u044F
      \u043E\u0447\u0435\u0440\u0435\u0434\u044C?"
    - "\u041A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0437\u043D\u0430\u0435\u0442
      \u043A\u0443\u0440\u0441 \u043C\u043E\u043D\u0435\u0442\u043A\u0438 \u043D\u0430
      \u0441\u0435\u0433\u043E\u0434\u043D\u044F?"
    - "\u0410 \u0435\u0441\u043B\u0438 \u043D\u0435\u0442 \u0434\u0432\u0443\u0445
      \u043C\u043E\u043D\u0435\u0442 - \u043F\u0435\u0448\u043A\u043E\u043C \u043F\u0443\u0441\u043A\u0430\u044E\u0442?"
    - "\u0410 \u0437\u043E\u043B\u043E\u0442\u044B\u0435 \u0437\u0443\u0431\u044B
      \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u044E\u0442?"
    - "\u042D\u0442\u043E\u0442 \u0425\u0430\u0440\u043E\u043D \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u0443\u0441\u0442\u0430\u0432\u0448\u0438\u043C..."
    - "\u0427\u0435\u0433\u043E \u043E\u043D \u0442\u0430\u043A \u043D\u0430 \u043D\u0430\u0441
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442?"
    - "\u0411\u0438\u043B\u0435\u0442 \u0432 \u043E\u0434\u0438\u043D \u043A\u043E\u043D\u0435\u0446,
      \u043A\u0430\u043A \u044F \u043B\u044E\u0431\u0438\u043B."
    - "\u0425\u043E\u0442\u044C \u0432 \u043E\u0434\u043D\u043E\u0439 \u043E\u0447\u0435\u0440\u0435\u0434\u0438
      \u043D\u0435 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0441\u0442\u043E\u044F\u0442\u044C
      \u0434\u0432\u0430\u0436\u0434\u044B"
    - "\u0410 \u0435\u0441\u043B\u0438 \u044F \u0431\u043E\u044E\u0441\u044C \u0432\u043E\u0434\u044B?"
    - "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u043C\u0435\u043D\u044F \u043D\u0435
      \u0443\u043A\u0430\u0447\u0430\u0435\u0442."
    - "\u0422\u0430\u043C \u0445\u043E\u0442\u044C \u0441\u043F\u0430\u0441\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u0436\u0438\u043B\u0435\u0442\u044B \u0435\u0441\u0442\u044C?"
    - "\u042F \u0438 \u043F\u0440\u0438 \u0436\u0438\u0437\u043D\u0438 \u0442\u0430\u043A\u0441\u0438
      \u0436\u0434\u0430\u043B \u043C\u0435\u043D\u044C\u0448\u0435!"
    - "\u041C\u043E\u0436\u043D\u043E \u0441 \u0441\u043E\u0431\u0430\u043A\u043E\u0439?"
    - "\u041D\u0430\u0434\u043E \u0431\u044B\u043B\u043E \u043C\u043E\u043D\u0435\u0442\u043A\u0443
      \u0432 \u043A\u0430\u0440\u043C\u0430\u043D \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C..."
    - "\u041C\u043E\u0436\u043D\u043E \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C
      \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u0447\u0438\u043A\u0430?"
    - "\u0412\u0435\u0447\u043D\u043E\u0441\u0442\u044C - \u044D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E
      \u043E\u0447\u0435\u043D\u044C \u0434\u043E\u043B\u0433\u0430\u044F \u043E\u0447\u0435\u0440\u0435\u0434\u044C."
    - "\u0410 \u0435\u0441\u043B\u0438 \u044F \u0440\u0430\u0441\u043F\u043B\u0430\u0447\u0443\u0441\u044C
      \u043A\u0440\u0438\u043F\u0442\u043E\u0439? \u0425\u0430\u0440\u043E\u043D,
      \u0443 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u043A\u0440\u0438\u043F\u0442\u043E\u0432\u0430\u043B\u044E\u0442\u043D\u044B\u0439
      \u043A\u043E\u0448\u0435\u043B\u0435\u043A?"
    - "\u041C\u043E\u043D\u0435\u0442\u043A\u0430 \u0437\u0430\u0441\u0442\u0440\u044F\u043B\u0430
      \u0432 \u0433\u043E\u0440\u043B\u0435. \u0418\u0440\u043E\u043D\u0438\u044F."
    - "\u0411\u043B\u0438\u043D, \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u043A\u043E\u0448\u0435\u043B\u0451\u043A
      \u0432 \u0434\u0440\u0443\u0433\u043E\u043C \u0441\u0430\u0432\u0430\u043D\u0435."
    - "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043E\u043D \u0432\u043E\u043E\u0431\u0449\u0435
      \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u0431\u0440\u0430\u043B
      \u043E\u0442\u043F\u0443\u0441\u043A?"
    - "\u042D\u0439, \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u0447\u0438\u043A,
      \u0443 \u0442\u0435\u0431\u044F \u0445\u043E\u0442\u044C \u043F\u0440\u0430\u0432\u0430
      \u0435\u0441\u0442\u044C? \u0410 \u0442\u043E \u043B\u043E\u0434\u043A\u0430
      \u043A\u0440\u0438\u0432\u0430\u044F!"
    - "\u0413\u0434\u0435 \u043C\u0435\u043D\u0435\u0434\u0436\u0435\u0440? \u041C\u043D\u0435
      \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C\u0441\u044F!"
    - "\u041D\u0430\u0434\u043E \u0431\u044B\u043B\u043E \u043A\u0440\u0435\u043C\u0438\u0440\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u2014 \u0433\u043B\u044F\u0434\u0438\u0448\u044C, \u0431\u044B\u0441\u0442\u0440\u0435\u0435
      \u0431\u044B \u0434\u043E\u043B\u0435\u0442\u0435\u043B."
    - "\u0416\u0438\u0437\u043D\u044C \u2014 \u0431\u043E\u043B\u044C. \u0421\u043C\u0435\u0440\u0442\u044C
      \u2014 \u043E\u0447\u0435\u0440\u0435\u0434\u044C. \u0412\u0441\u0451 \u043B\u043E\u0433\u0438\u0447\u043D\u043E."
    - "\u0410 \u043A\u043E\u043C\u0444\u043E\u0440\u0442-\u043A\u043B\u0430\u0441\u0441
      \u0435\u0441\u0442\u044C? \u042F \u043A\u043B\u0430\u0443\u0441\u0442\u0440\u043E\u0444\u043E\u0431!"
    - "\u042F \u0443\u043C\u0435\u0440 \u043E\u0442 \u0441\u043C\u0435\u0445\u0430.
      \u0422\u0435\u043F\u0435\u0440\u044C \u043C\u043D\u0435 \u043D\u0435 \u0434\u043E
      \u0448\u0443\u0442\u043E\u043A."
    - "\u0425\u0430\u0440\u043E\u043D, \u0430 \u043C\u043E\u0436\u043D\u043E \u0432
      \u0440\u0430\u0441\u0441\u0440\u043E\u0447\u043A\u0443? \u041F\u043E \u043C\u043E\u043D\u0435\u0442\u043A\u0435
      \u0432 \u0432\u0435\u0447\u043D\u043E\u0441\u0442\u044C."
    - "\u0425\u0430\u0440\u043E\u043D, \u0430 \u043A\u0443\u0440\u0441 '\u041A\u0430\u043A
      \u043D\u0435 \u0443\u0442\u043E\u043D\u0443\u0442\u044C \u0432 \u041B\u0435\u0442\u0435'
      \u0435\u0441\u0442\u044C?"
    - "\u041B\u0443\u0447\u0448\u0438\u0439 \u0441\u043F\u043E\u0441\u043E\u0431
      \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u0438\u0442\u044C\u0441\u044F \u2014
      \u0443\u043C\u0435\u0440\u0435\u0442\u044C"
    - "\u0412\u0435\u0447\u043D\u043E\u0441\u0442\u044C \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
      \u0437\u0434\u0435\u0441\u044C. \u0421\u0442\u043E\u0438\u043C."
    - "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043E\u043D \u0441\u0430\u043C
      \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u0442\u043E\u043D\u0443\u043B?"
    - "\u042F \u0432 \u0430\u0434\u0443 \u0438\u043B\u0438 \u0432 \u0420\u043E\u0441\u0442\u043E\u0432\u0435?
      \u0420\u0430\u0437\u043D\u0438\u0446\u044B \u043D\u0435 \u0432\u0438\u0436\u0443..."
    - "\u0425\u0430\u0440\u043E\u043D, \u043C\u043E\u0436\u0435\u0442, \u0432\u043A\u043B\u044E\u0447\u0438\u0448\u044C
      \u043C\u0443\u0437\u044B\u043A\u0443? \u0425\u043E\u0442\u044F \u0431\u044B
      \u043F\u043E\u0445\u043E\u0440\u043E\u043D\u043D\u044B\u0439 \u043C\u0430\u0440\u0448."
  - m_speechSituation: 1
    m_speechReplics:
    - "\u041C\u044B \u0443\u0436\u0435 \u043F\u0440\u0438\u0435\u0445\u0430\u043B\u0438?"
    - "\u0410 \u0442\u0443\u0442 \u0435\u0441\u0442\u044C \u0431\u043B\u044E\u0442\u0443\u0441?"
    - "\u0410 \u043C\u043E\u0436\u043D\u043E \u0444\u043E\u0440\u0442\u043E\u0447\u043A\u0443
      \u043F\u0440\u0438\u043A\u0440\u044B\u0442\u044C?"
    - "\u042F \u0443\u043C\u0435\u0440, \u043F\u043E\u043A\u0430 \u0436\u0434\u0430\u043B
      \u043E\u0442\u0432\u0435\u0442\u0430 \u043E\u0442 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438.
      \u0418 \u0442\u0435\u043F\u0435\u0440\u044C \u0432\u044B \u043C\u043D\u0435
      \u0442\u043E\u0436\u0435 \u043D\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442\u0435?!"
    - "\u042F \u0443\u043C\u0435\u0440, \u043F\u043E\u043A\u0430 \u0436\u0434\u0430\u043B
      \u043E\u0442\u0432\u0435\u0442\u0430 \u043E\u0442 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438.
      \u0418 \u0442\u0435\u043F\u0435\u0440\u044C \u0432\u044B \u043C\u043D\u0435
      \u0442\u043E\u0436\u0435 \u043D\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442\u0435?!"
    - "\u041F\u043E\u0447\u0435\u043C\u0443 \u0443 \u0432\u0430\u0441 \u0432 \u043B\u043E\u0434\u043A\u0435
      \u043D\u0435\u0442 \u043F\u043E\u0434\u0443\u0448\u0435\u043A? \u042F \u0436\u0435
      \u0446\u0430\u0440\u044C, \u043C\u043D\u0435 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043E!"
    - "\u042F \u0443\u043C\u0435\u0440 \u0432\u043E \u0441\u043D\u0435\u2026 \u0422\u0430\u043A
      \u044F \u0441\u0435\u0439\u0447\u0430\u0441 \u0441\u043F\u043B\u044E \u0438\u043B\u0438
      \u043D\u0435\u0442?"
    - "\u042D\u0439, \u0430 \u0435\u0441\u043B\u0438 \u044F \u0441\u0431\u0435\u0433\u0443
      \u2014 \u044F \u0441\u0442\u0430\u043D\u0443 \u0433\u043B\u0430\u0432\u043D\u044B\u043C
      \u0433\u0435\u0440\u043E\u0435\u043C?"
    - "\u042F \u0434\u0443\u043C\u0430\u043B, \u0441\u043C\u0435\u0440\u0442\u044C
      \u2014 \u044D\u0442\u043E \u043A\u0430\u043A \u0432 \u043A\u0438\u043D\u043E\u2026"
    - "\u042F \u043D\u0435 \u0443\u043C\u0440\u0443! \u042D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u043B\u043E\u0445\u043E\u0439 \u0440\u0435\u043D\u0434\u0435\u0440!"
    - "\u0413\u0434\u0435 \u0447\u0438\u0442-\u043A\u043E\u0434\u044B? \u042F \u043D\u0435
      \u0441\u043E\u0433\u043B\u0430\u0441\u0435\u043D \u043D\u0430 \u0445\u0430\u0440\u0434\u043A\u043E\u0440!"
    - "\u042D\u0442\u043E Early Access? \u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E
      \u0432\u0435\u0447\u043D\u043E\u0441\u0442\u044C \u2014 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0434\u043E\u043B\u0433\u043E."
    - "\u042F \u043D\u0435 \u0431\u0440\u0430\u043B DLC \xAB\u0411\u0435\u0437\u0432\u0440\u0435\u043C\u0435\u043D\u044C\u0435\xBB.
      \u0412\u0435\u0440\u043D\u0438\u0442\u0435 \u0434\u0435\u043D\u044C\u0433\u0438!"
    - "\u041C\u043E\u0436\u043D\u043E \u0432\u0442\u043E\u0440\u0443\u044E \u043F\u043E\u043F\u044B\u0442\u043A\u0443?
      \u042F \u043D\u0435 \u0433\u043E\u0442\u043E\u0432!"
    - "\u0412\u0435\u0440\u043D\u0438\u0442\u0435 \u043C\u0435\u043D\u044F \u043D\u0430\u0437\u0430\u0434,
      \u044F \u043D\u0435 \u0434\u043E\u0436\u0434\u0430\u043B\u0441\u044F \u0440\u0435\u043B\u0438\u0437\u0430
      WL!"
    - "\u041F\u043E\u0447\u0435\u043C\u0443 \u0443 \u0432\u0430\u0441 \u043D\u0435\u0442
      wi-fi? \u042F \u043D\u0435 \u0443\u0441\u043F\u0435\u043B \u0437\u0430\u043F\u043E\u0441\u0442\u0438\u0442\u044C
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0441\u0435\u043B\u0444\u0438!"
    - "\u041F\u043E\u0447\u0435\u043C\u0443 \u0443 \u0432\u0430\u0441 \u043D\u0435\u0442
      wi-fi? \u042F \u043D\u0435 \u0443\u0441\u043F\u0435\u043B \u0437\u0430\u043F\u043E\u0441\u0442\u0438\u0442\u044C
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0441\u0435\u043B\u0444\u0438!"
    - "\u042D\u0442\u043E \u0445\u0430\u0440\u0434\u043A\u043E\u0440-\u0440\u0435\u0436\u0438\u043C?
      \u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E respawn \u043D\u0435
      \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442\u2026"
    - "\u042F \u043D\u0435 \u0443\u0441\u043F\u0435\u043B \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u044C
      \u0443\u0442\u044E\u0433\u2026"
    - "\u0421\u0442\u043E\u043F, \u0430 \u043F\u043E\u0447\u0435\u043C\u0443 \u043D\u0435
      \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0410\u043B\u0442\u0430\u0440\u044C
      \u0413\u0435\u0440\u043E\u0435\u0432? \u0410 \u0441\u0432\u0438\u0442\u043E\u043A
      \u0412\u043E\u0441\u043A\u0440\u0435\u0448\u0435\u043D\u0438\u044F?!"
    - "\u041A\u0430\u043A \u044D\u0442\u043E - \u0411\u0435\u0437\u0432\u0440\u0435\u043C\u0435\u043D\u044C\u0435?
      \u0412\u044B \u0447\u0442\u043E, \u044F - \u0447\u0430\u0441\u043E\u0432\u0449\u0438\u043A,
      \u043C\u043D\u0435 \u0436 \u043D\u0435\u043B\u044C\u0437\u044F!"
    - "\u0423 \u043C\u0435\u043D\u044F \u0442\u0430\u043C \u0431\u043E\u0440\u0449
      \u043D\u0430 \u043F\u043B\u0438\u0442\u0435!"
    - "\u042F \u043D\u0435 \u0432\u0437\u044F\u043B \u0441 \u0441\u043E\u0431\u043E\u0439
      \u0437\u0430\u0440\u044F\u0434\u043A\u0443. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0432\u0435\u0447\u043D\u043E\u0441\u0442\u044C \u0431\u0435\u0437 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0430\u2026"
    - "\u042F \u0434\u0443\u043C\u0430\u043B, \u0441\u043C\u0435\u0440\u0442\u044C
      \u2014 \u044D\u0442\u043E \u043A\u043E\u043D\u0435\u0446. \u0410 \u044D\u0442\u043E
      \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u0430\u043A\u0430\u044F-\u0442\u043E
      \u0438\u0433\u0440\u0430."
    - "\u0413\u0434\u0435 \u0441\u043C\u044B\u0441\u043B? \u041C\u043D\u0435 \u043E\u0431\u0435\u0449\u0430\u043B\u0438
      \u0441\u043C\u044B\u0441\u043B!"
    - "\u042F \u043D\u0435 \u043F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u043B\u0441\u044F
      \u043D\u0430 \u044D\u0442\u043E!"
    - "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043A\u0430\u043A
      \u043E\u043D\u0438 \u0442\u0430\u043C \u043C\u043E\u0435 \u043D\u0430\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u043E
      \u043F\u043E\u0434\u0435\u043B\u044F\u0442?"
    - "\u042D\u0439, \u043F\u043E\u043B\u0435\u0433\u0447\u0435, \u043D\u0435 \u043A\u0430\u0440\u0442\u043E\u0448\u043A\u0443
      \u0432\u0435\u0437\u0435\u0448\u044C!"
    - "\u0416\u0430\u043B\u044C, \u0430 \u044F \u0442\u0430\u043A \u0438 \u043D\u0435
      \u0443\u0437\u043D\u0430\u043B, \u0432\u044B\u0439\u0434\u0435\u0442 \u043B\u0438
      \u0424\u041C 2026..."
    - "\u041D\u0443 \u0447\u0442\u043E, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u0438,
      \u0442\u0435\u043F\u0435\u0440\u044C-\u0442\u043E \u043C\u044B \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043C\u0441\u044F?!"
    - "\u042D\u0442\u043E \u0432\u043E\u043E\u0431\u0449\u0435 \u0437\u0430\u043A\u043E\u043D\u043D\u043E?
      \u042F \u0432 \u0438\u0433\u0440\u0435 \u0438\u043B\u0438 \u043D\u0435\u0442?"
    - "\u0412 \u0441\u043C\u044B\u0441\u043B\u0435 - \"\u0411\u0435\u0437\u0432\u0440\u0435\u043C\u0435\u043D\u044C\u0435\"?
      \u042F \u0432 \u0440\u0430\u0439 \u0445\u043E\u0442\u0435\u043B, \u043D\u0443
      \u0438\u043B\u0438 \u0430\u0434 \u043D\u0430 \u043A\u0440\u0430\u0439\u043D\u044F\u043A!"
    - "\u042F \u043E\u0448\u0438\u0431\u0441\u044F, \u044F \u043C\u043E\u0433\u0443
      \u043E\u0434\u0438\u043D \u0440\u0430\u0437 \u043E\u0448\u0438\u0431\u0438\u0442\u044C\u0441\u044F!"
    - "\u041A\u0430\u043A \u0442\u0430\u043A-\u0442\u043E? \u042F \u0436\u0435 \u043F\u0435\u0440\u0432\u044B\u0439
      \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0438\u043B!"
    - "\u042F \u0432\u0441\u0435 \u0435\u0449\u0435 \u0432 \u043D\u0438\u0440\u0432\u0430\u043D\u0435?
      \u041A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C, \u043F\u043E\u043C\u043E\u0433\u0438\u0442\u0435
      \u0432\u044B\u0439\u0442\u0438 \u0438\u0437 \u043C\u0435\u0434\u0438\u0442\u0430\u0446\u0438\u0438!"
    - "\u0412\u0440\u0435\u043C\u044F \u2014 \u044D\u0442\u043E \u0438\u043B\u043B\u044E\u0437\u0438\u044F.
      \u041D\u043E \u0438\u043B\u043B\u044E\u0437\u0438\u044F \u0431\u044B\u043B\u0430
      \u043F\u0440\u0438\u044F\u0442\u043D\u0435\u0435."
    - "\u0411\u0435\u0437\u0432\u0440\u0435\u043C\u0435\u043D\u044C\u0435 \u2014
      \u044D\u0442\u043E \u043A\u043E\u0433\u0434\u0430 \u0434\u0430\u0436\u0435
      \u0445\u0430\u043E\u0441 \u0443\u0441\u0442\u0430\u043B."
    - "\u0420\u0430\u043D\u044C\u0448\u0435 \u044F \u0431\u043E\u044F\u043B\u0441\u044F
      \u0441\u043C\u0435\u0440\u0442\u0438. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0431\u043E\u044E\u0441\u044C, \u0447\u0442\u043E \u044D\u0442\u043E \u0438
      \u0435\u0441\u0442\u044C \u0436\u0438\u0437\u043D\u044C."
    - "\u0414\u0435\u043B\u0430\u043B \u0434\u0435\u043B\u0430, \u043F\u043E\u043A\u0430
      \u043D\u0435 \u043A\u043E\u043D\u0447\u0438\u043B\u043E\u0441\u044C \u0432\u0440\u0435\u043C\u044F.
      \u0422\u0435\u043F\u0435\u0440\u044C \u0434\u0435\u043B \u043D\u0435\u0442.
      \u0418 \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0442\u043E\u0436\u0435."
    - "\u0413\u0434\u0435 \u0442\u0430\u0439\u043C\u0435\u0440? \u042F \u043D\u0435
      \u0432\u0438\u0436\u0443 \u0442\u0430\u0439\u043C\u0435\u0440!"
    - "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u043E\u043D \u0435\u0449\u0435
      \u043D\u0430\u0441 \u0431\u0443\u0434\u0435\u0442 \u0432\u0435\u0437\u0442\u0438?!
      \u0412 \u0441\u043C\u044B\u0441\u043B\u0435 - \"\u0445\u043E\u0442\u044C \u0432\u0435\u0447\u043D\u043E\u0441\u0442\u044C\"?!"
    - "\u0412\u0440\u0435\u043C\u044F \u043A\u043E\u043D\u0447\u0438\u043B\u043E\u0441\u044C.
      \u0422\u0435\u043F\u0435\u0440\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0435."
    - "\u0420\u0430\u043D\u044C\u0448\u0435 \u044F \u0431\u043E\u044F\u043B\u0441\u044F
      \u043D\u0435 \u0443\u0441\u043F\u0435\u0442\u044C. \u0422\u0435\u043F\u0435\u0440\u044C
      \u043D\u0435\u043A\u0443\u0434\u0430 \u0441\u043F\u0435\u0448\u0438\u0442\u044C."
    - "\u042D\u0439, \u0430 \u043A\u043E\u0433\u0434\u0430 \u0443 \u0432\u0430\u0441
      \u043E\u0431\u0435\u0434?"
    - "\u0425\u043E\u0447\u0443 \u0435\u0445\u0430\u0442\u044C \u0437\u0430\u0434\u043E\u043C
      \u043D\u0430\u043F\u0435\u0440\u0451\u0434!"
    - "\u0421\u043E\u0433\u043B\u0430\u0441\u0435\u043D \u0441 \u0443\u043C\u0438\u0440\u0430\u043D\u0438\u0435\u043C."
    - "\u042F \u0443\u043C\u0435\u0440 \u043F\u043E \u043E\u0448\u0438\u0431\u043A\u0435,
      \u043C\u043E\u0436\u043D\u043E \u043E\u0442\u043C\u0435\u043D\u0438\u0442\u044C?"
    - "\u042F \u0431\u043E\u044E\u0441\u044C \u0432\u043E\u0434\u044B..."
    - "\u0425\u043E\u0447\u0443 VIP-\u0440\u0435\u043A\u0443, \u0441 \u043F\u0443\u0437\u044B\u0440\u044C\u043A\u0430\u043C\u0438!"
    - "\u0425\u043E\u0447\u0443 \u043F\u0435\u0440\u0435\u0440\u043E\u0434\u0438\u0442\u044C\u0441\u044F
      \u043A\u0430\u043A \u043A\u043E\u0448\u043A\u0430."
    - "\u0425\u043E\u0447\u0443 \u0443\u043C\u0435\u0440\u0435\u0442\u044C \u0435\u0449\u0451
      \u0440\u0430\u0437, \u043D\u043E \u043A\u0440\u0430\u0441\u0438\u0432\u043E..."
    - "\u0410 \u043C\u043E\u0436\u043D\u043E \u043D\u0435 \u0443\u043C\u0438\u0440\u0430\u0442\u044C?"
    - "\u042F \u0432\u043E\u043E\u0431\u0449\u0435-\u0442\u043E \u0431\u043E\u0433\u0430\u0447,
      \u043C\u043D\u0435 \u0442\u0443\u0434\u0430 \u043D\u0435 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043E!"
    - "\u0417\u0430\u0435\u0434\u0435\u043C \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0435
      \u0432 \u0440\u0430\u0439? \u041C\u043D\u0435 \u0442\u0430\u043C \u0437\u0430\u0431\u0440\u0430\u0442\u044C
      \u043D\u0443\u0436\u043D\u043E \u043A\u043E\u0435-\u0447\u0442\u043E."
    - "\u0410 \u0447\u0442\u043E \u0442\u0430\u043C \u043F\u043E \u043F\u043E\u0432\u043E\u0434\u0443
      \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u0445 \u043D\u0430\u043F\u0438\u0442\u043A\u043E\u0432
      \u043D\u0430 \u0431\u043E\u0440\u0442\u0443?"
    - "\u041A\u0442\u043E \u043C\u043D\u0435 \u0441\u043A\u0430\u0436\u0435\u0442,
      \u043A\u0443\u0434\u0430 \u044F \u043C\u043E\u0433\u0443 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C
      \u0441\u0432\u043E\u044E \u0436\u0430\u043B\u043E\u0431\u0443 \u043D\u0430
      \u0441\u0435\u0440\u0432\u0438\u0441?"
    - "\u0423 \u0432\u0430\u0441 \u0442\u0443\u0442 \u0442\u043E\u0447\u043D\u043E
      GPS \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442? \u042F \u043D\u0430\u0434\u0435\u044E\u0441\u044C,
      \u044D\u0442\u043E \u043D\u0435 \u043A\u0430\u043A\u043E\u0439-\u0442\u043E
      \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u044B\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442!"
    - "\u041C\u043D\u0435, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
      \u043D\u0435 \u0432 \u0430\u0434! \u0412 \u0411\u0435\u0437\u0432\u0440\u0435\u043C\u0435\u043D\u044C\u0435
      - \u043D\u0435 \u043D\u0430\u0434\u043E!"
    - "\u0423 \u0432\u0430\u0441 \u0442\u043E\u0447\u043D\u043E \u0435\u0441\u0442\u044C
      \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044F \u043D\u0430 \u044D\u0442\u043E\u0442
      \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442?"
    - "\u0410 \u043C\u043E\u0436\u043D\u043E \u0433\u0434\u0435-\u0442\u043E \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F,
      \u043F\u043E\u043A\u0443\u0440\u0438\u0442\u044C?"
    - "\u0421\u043B\u0443\u0448\u0430\u0439\u0442\u0435, \u0430 \u0443 \u0432\u0430\u0441
      \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F \u0437\u0430\u0431\u0440\u0430\u0442\u044C
      \u043C\u0435\u043D\u044F \u0441 \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B?"
    - "\u041D\u0443 \u0447\u0442\u043E, \u043A\u0443\u0434\u0430 \u043C\u044B \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u0435\u0434\u0435\u043C?"
    - "\u0410 \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0431\u044B\u0441\u0442\u0440\u0435\u0435?
      \u042F \u043E\u043F\u0430\u0437\u0434\u044B\u0432\u0430\u044E!"
    - "\u042D\u0439, \u043C\u043E\u0436\u043D\u043E \u044F \u043F\u043E\u043A\u0430
      \u043F\u043E\u0441\u043F\u043B\u044E?"
    - "\u0421\u043B\u0443\u0448\u0430\u0439, \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E
      \u0432\u044B\u0441\u0430\u0434\u0438\u0442\u044C\u0441\u044F \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0435. \u042F \u043F\u0435\u0440\u0435\u0434\u0443\u043C\u0430\u043B!"
    - "\u041F\u043E\u0433\u043E\u0434\u0438, \u0430 \u044F \u043D\u0435 \u043F\u0435\u0440\u0435\u043F\u043B\u044B\u0432\u0430\u044E
      \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E \u0432 \u0434\u0440\u0443\u0433\u043E\u0439
      \u043C\u0438\u0440?"
    - "\u042D\u0439, \u0433\u0434\u0435 \u0442\u0443\u0442 \u043D\u043E\u0447\u043D\u044B\u0435
      \u043A\u043B\u0443\u0431\u044B \u0434\u043B\u044F \u0434\u0443\u0448?"
    - "\u0410 \u043C\u043E\u0436\u043D\u043E \u0431\u0435\u0437 \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043E\u0432?\_"
    - "\u042D\u0439, \u0430 \u0447\u0442\u043E, \u0437\u0430\u0433\u0440\u043E\u0431\u043D\u0430\u044F
      \u0436\u0438\u0437\u043D\u044C \u0442\u0430\u043A \u0438 \u0431\u0443\u0434\u0435\u0442
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u044C \u0432 \u044D\u0442\u043E\u0439
      \u043B\u043E\u0434\u043A\u0435?\_"
    - "\u041D\u0438\u0447\u0435\u0433\u043E \u0441\u0435\u0431\u0435, \u0437\u0430\u0433\u0440\u043E\u0431\u043D\u044B\u0439
      \u043A\u0440\u0443\u0438\u0437!"
    - "\u041F\u043E\u0447\u0435\u043C\u0443 \u0443 \u0442\u0435\u0431\u044F \u043D\u0430
      \u043B\u043E\u0434\u043A\u0435 \u043D\u0435\u0442 \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u0435\u0439?
      \u042D\u0442\u043E \u0436\u0435 \u0437\u0430\u0433\u0440\u043E\u0431\u043D\u0430\u044F
      \u0432\u0435\u0447\u043D\u043E\u0441\u0442\u044C!"
    - "\u0410 \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0435 \u0431\u0443\u0434\u0443\u0442
      \u0436\u0438\u0432\u044B\u0435? \u0418\u043B\u0438 \u0432\u0441\u0451 \u0442\u0430\u043A
      \u0436\u0435 \u043C\u0435\u0440\u0442\u0432\u044B\u0435?"
    - "\u0421\u043B\u0443\u0448\u0430\u0439, \u043C\u044B \u0432\u043E\u043E\u0431\u0449\u0435
      \u043A\u0443\u0434\u0430-\u0442\u043E \u043F\u043B\u044B\u0432\u0435\u043C
      \u0438\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E \u043A\u0440\u0443\u0433\u0443?"
    - "\u042D\u0442\u043E \u0447\u0442\u043E, \u0432\u0435\u0441\u044C \u043F\u0443\u0442\u044C?
      \u042F \u0434\u0443\u043C\u0430\u043B, \u0442\u0443\u0442 \u0445\u043E\u0442\u044F
      \u0431\u044B \u043A\u0430\u043A\u0438\u0435-\u0442\u043E \u0430\u0442\u0442\u0440\u0430\u043A\u0446\u0438\u043E\u043D\u044B!"
    - "\u042D\u0439, \u0430 \u043F\u043E\u0447\u0435\u043C\u0443 \u0442\u0430\u043A
      \u0442\u0438\u0445\u043E? \u041C\u043D\u0435 \u0431\u044B \u0445\u043E\u0442\u044F
      \u0431\u044B \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043C\u0443\u0437\u044B\u043A\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0441\u043E\u043F\u0440\u043E\u0432\u043E\u0436\u0434\u0435\u043D\u0438\u044F!"
    - "\u0410 \u0432 \u0432\u0430\u0448\u0435\u043C \u0437\u0430\u0433\u0440\u043E\u0431\u043D\u043E\u043C
      \u043C\u0438\u0440\u0435 \u0442\u043E\u0447\u043D\u043E \u043D\u0435\u0442
      \u0432\u0441\u044F\u043A\u0438\u0445 \u0432\u043E\u0434\u043D\u044B\u0445 \u0433\u043E\u0440\u043E\u043A?"
    - "\u042F \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0435\u043B \u0431\u044B
      \u0435\u0445\u0430\u0442\u044C \u0441 \u043A\u0435\u043C-\u0442\u043E \u0431\u043E\u043B\u0435\u0435
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u043C!"
    - "\u0421\u0435\u0440\u044C\u0435\u0437\u043D\u043E, \u044D\u0442\u043E \u0432\u0435\u0441\u044C
      \u043F\u0440\u043E\u0446\u0435\u0441\u0441? \u0413\u0434\u0435 \u0432\u0441\u0435
      \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0435 \u0442\u0432\u0430\u0440\u0438?"
  - m_speechSituation: 2
    m_speechReplics:
    - "\u041C\u043D\u0435 \u043D\u0435 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u043E\u0441\u044C,
      \u0434\u0438\u043B\u0430\u0439\u043A!"
    - "\u0411\u0443\u0434\u0443 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u043E\u0432\u0430\u0442\u044C
      \u0432\u0430\u0441!"
    - "\u041D\u0443 \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u0442\u043E!"
  - m_speechSituation: 2
    m_speechReplics:
    - "\u041C\u043D\u0435 \u043D\u0435 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u043E\u0441\u044C,
      \u0434\u0438\u043B\u0430\u0439\u043A!"
    - "\u0411\u0443\u0434\u0443 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u043E\u0432\u0430\u0442\u044C
      \u0432\u0430\u0441!"
    - "\u041D\u0443 \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u0442\u043E!"
  m_haronSpeechReplics:
  - m_speechSituation: 1
    m_speechReplics:
    - "\u0412\u0430\u043C \u0448\u0430\u0448\u0435\u0447\u043A\u0438 \u0438\u043B\u0438
      \u0432\u0435\u0437\u0442\u0438?"
    - "\u0412\u0441\u0435 \u0434\u0443\u043C\u0430\u044E\u0442, \u0447\u0442\u043E
      \u044F \u043B\u044E\u0431\u043B\u044E \u0441\u0432\u043E\u044E \u0440\u0430\u0431\u043E\u0442\u0443
      -  \u0430 \u044F \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u043C\u043E\u0433\u0443
      \u0443\u0432\u043E\u043B\u0438\u0442\u044C\u0441\u044F."
    - "\u041B\u043E\u0434\u043A\u0430 \u0441\u0442\u0430\u0440\u0430\u044F, \u0432\u0451\u0441\u043B\u0430
      \u0441\u043A\u0440\u0438\u043F\u044F\u0442, \u0434\u0443\u0448\u0438 \u043D\u043E\u044E\u0442\u2026"
    - "\u042F\u0445\u0442\u0430\u2026 \u041F\u0430\u043B\u044C\u043C\u044B\u2026
      \u0418 \u043D\u0438 \u043E\u0434\u043D\u043E\u0439 \u0434\u0443\u0448\u0438
      \u0432 \u0442\u0440\u044E\u043C\u0435\u2026"
    - "\u041A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u044F
      \u0443\u043F\u043B\u044B\u0432\u0443. \u041A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C\u2026"
    - "\u042F\u0445\u0442\u0430 \u043C\u043E\u0435\u0439 \u043C\u0435\u0447\u0442\u044B
      \u0434\u0430\u0436\u0435 \u043D\u0435 \u0437\u043D\u0430\u0435\u0442, \u0447\u0442\u043E
      \u044F \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E."
    - "\u0411\u0435\u0437\u0432\u0440\u0435\u043C\u0435\u043D\u044C\u0435 \u2014
      \u044D\u0442\u043E \u043A\u043E\u0433\u0434\u0430 \xAB\u0441\u043A\u043E\u0440\u043E\xBB
      \u0438 \xAB\u043D\u0438\u043A\u043E\u0433\u0434\u0430\xBB \u2014 \u043E\u0434\u043D\u043E
      \u0438 \u0442\u043E \u0436\u0435."
    - "\u0418\u043D\u043E\u0433\u0434\u0430 \u044F \u0441\u0442\u0430\u0432\u043B\u044E
      \u043F\u0435\u0441\u043E\u0447\u043D\u044B\u0435 \u0447\u0430\u0441\u044B\u2026
      \u043F\u0440\u043E\u0441\u0442\u043E \u0434\u043B\u044F \u0434\u0435\u043A\u043E\u0440\u0430."
    - "\u0412\u0435\u0447\u043D\u043E\u0441\u0442\u044C \u2014 \u044D\u0442\u043E
      \u043A\u043E\u0433\u0434\u0430 \u0442\u044B \u0443\u0436\u0435 \u0437\u0430\u0431\u044B\u043B,
      \u0447\u0442\u043E \u0442\u0430\u043A\u043E\u0435 \xAB\u0436\u0434\u0430\u0442\u044C\xBB."
    - "\u041E\u043D \u0443\u043C\u0435\u0440 \u043E\u0442 \u0447\u0435\u0433\u043E?
      \u041E\u0442 \u0436\u0430\u0434\u043D\u043E\u0441\u0442\u0438? \u041E, \u0441\u044E\u0440\u043F\u0440\u0438\u0437."
    - "\u041F\u043E\u0447\u0435\u043C\u0443 \u0432\u0441\u0435 \u0434\u0443\u0448\u0438
      \u0442\u0430\u043A\u0438\u0435\u2026 \u043B\u0438\u043F\u043A\u0438\u0435?"
    - "\u042F \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0441\u0442\u0430\u0440
      \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E\u2026 \u0410 \u043D\u0435\u0442,
      \u044F \u0431\u0435\u0441\u0441\u043C\u0435\u0440\u0442\u0435\u043D."
    - "\u041C\u0435\u043D\u044F \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0446\u0435\u043D\u0438\u0442.
      \u0414\u0430\u0436\u0435 \u0426\u0435\u0440\u0431\u0435\u0440."
    - "\u0418\u043D\u043E\u0433\u0434\u0430 \u044F \u0436\u0430\u043B\u0435\u044E,
      \u0447\u0442\u043E \u043D\u0435 \u043C\u043E\u0433\u0443 \u0443\u043C\u0435\u0440\u0435\u0442\u044C."
    - "\u0427\u0442\u043E \u0442\u044F\u0436\u0435\u043B\u0435\u0435: \u0434\u0443\u0448\u0430
      \u0433\u0440\u0435\u0448\u043D\u0438\u043A\u0430 \u0438\u043B\u0438 \u043C\u043E\u0451
      \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0435?"
    - "\u0415\u0441\u043B\u0438 \u044F \u0437\u0430\u043A\u0440\u043E\u044E \u0433\u043B\u0430\u0437\u0430,
      \u043C\u043E\u0436\u0435\u0442, \u043E\u043D\u0438 \u0432\u0441\u0435 \u0438\u0441\u0447\u0435\u0437\u043D\u0443\u0442?"
    - "\u041F\u043E\u0447\u0435\u043C\u0443 \u0443 \u0432\u0441\u0435\u0445 \u0434\u0443\u0448
      \u0435\u0441\u0442\u044C \u0432\u043E\u043F\u0440\u043E\u0441\u044B? \u0423
      \u043C\u0435\u043D\u044F \u043D\u0435\u0442 \u043E\u0442\u0432\u0435\u0442\u043E\u0432!"
    - "\u0415\u0441\u043B\u0438 \u0431\u044B \u0443 \u043C\u0435\u043D\u044F \u0431\u044B\u043B
      \u0432\u044B\u0431\u043E\u0440, \u044F \u0431\u044B \u0432\u044B\u0431\u0440\u0430\u043B\u2026
      \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0435."
    - "\u042F \u0443\u0441\u0442\u0430\u043B, \u0431\u043E\u0441\u0441. \u041F\u0440\u043E\u0441\u0442\u043E
      \u0443\u0441\u0442\u0430\u043B."
    - "\u0416\u0438\u0437\u043D\u044C \u2014 \u043A\u0430\u043A \u043B\u043E\u0434\u043A\u0430:
      \u0442\u043E\u043D\u0435\u0442 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E,
      \u043D\u043E \u0432\u0435\u0440\u043D\u043E."
    - "\u0414\u0435\u0440\u0436\u0438 \u0434\u0440\u0443\u0437\u0435\u0439 \u0431\u043B\u0438\u0437\u043A\u043E,
      \u0430 \u0434\u0443\u0448\u0438 \u2014 \u0435\u0449\u0451 \u0431\u043B\u0438\u0436\u0435.
      \u0412 \u043B\u043E\u0434\u043A\u0435."
    - "\u0414\u0443\u0448\u0438. \u0414\u0443\u0448\u0438 \u043D\u0438\u043A\u043E\u0433\u0434\u0430
      \u043D\u0435 \u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F\u2026"
    - "\u0418\u043B\u0438 \u044F \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u0447\u0438\u043A,
      \u0438\u043B\u0438 \u043C\u043D\u0435 \u044D\u0442\u043E \u0441\u043D\u0438\u0442\u0441\u044F."
    - "\u042F \u0441\u0442\u0430\u043B \u0441\u043C\u0435\u0440\u0442\u044C\u044E,
      \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u0442\u0435\u043B\u0435\u043C\u2026
      \u0442\u0430\u043A\u0441\u0438\u0441\u0442\u043E\u043C."
    - "\u0418 \u043F\u043E\u043D\u0435\u0441\u043B\u0430\u0441\u044C \u0434\u0443\u0448\u0430
      \u043D\u0430 \u0434\u043D\u043E\u2026"
    - "\u042F \u043C\u044B\u0441\u043B\u044E \u2014 \u0437\u043D\u0430\u0447\u0438\u0442,
      \u044F \u0443\u0441\u0442\u0430\u043B."
    - "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439 \u0442\u044C\u043C\u0430,
      \u043C\u043E\u0439 \u0441\u0442\u0430\u0440\u044B\u0439 \u0434\u0440\u0443\u0433\u2026"
    - "\u042F \u043D\u0435 \u0436\u0438\u0432\u0443. \u042F \u043F\u0440\u043E\u0441\u0442\u043E\u2026
      \u043D\u0435 \u0443\u0445\u043E\u0436\u0443."
    - "\u042F \u043A\u0430\u043A Wi-Fi \u0432 \u043C\u0435\u0442\u0440\u043E: \u0432\u0441\u0435
      \u043C\u043D\u043E\u0439 \u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F,
      \u043D\u043E \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442."
    - "\u041B\u0443\u0447\u0448\u0438\u0439 \u0434\u0435\u043D\u044C \u0432 \u043C\u043E\u0435\u0439
      \u0432\u0435\u0447\u043D\u043E\u0441\u0442\u0438? \u0422\u043E\u0442, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u043D\u0435 \u0431\u044B\u043B\u043E."
    - "\u042F\u0445\u0442\u0430, \u043F\u0430\u043B\u044C\u043C\u044B, \u043A\u043E\u043A\u043E\u0441\u044B\u2026
      \u0410 \u043F\u043E\u043A\u0430 \u2014 \u0433\u0440\u0435\u0431\u0443, \u043A\u0430\u043A
      \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u044B\u0439."
    - "\u041B\u043E\u0434\u043A\u0430 \u0434\u044B\u0440\u044F\u0432\u0430\u044F,
      \u043A\u0430\u043A \u043C\u043E\u044F \u043C\u043E\u0442\u0438\u0432\u0430\u0446\u0438\u044F."
    - "\u0415\u0441\u043B\u0438 \u0431\u044B \u0434\u0443\u0448\u0438 \u0431\u044B\u043B\u0438
      \u0442\u0438\u0448\u0435, \u044F \u0431\u044B, \u043C\u043E\u0436\u0435\u0442,
      \u0438 \u043D\u0435 \u0437\u043B\u0438\u043B\u0441\u044F."
    - "\u0414\u0443\u0448\u0438 \u043D\u043E\u044E\u0442 \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u0438\u0433\u0440\u043E\u043A\u0438 \u043D\u0430 \u0444\u043E\u0440\u0443\u043C\u0430\u0445."
    - "\u0415\u0441\u043B\u0438 \u0431\u044B \u044F \u043F\u043E\u043B\u0443\u0447\u0430\u043B
      \u043C\u043E\u043D\u0435\u0442\u043A\u0443 \u0437\u0430 \u043A\u0430\u0436\u0434\u0443\u044E
      \u0436\u0430\u043B\u043E\u0431\u0443..."
    - "\u041B\u043E\u0434\u043A\u0430 \u0441\u043A\u0440\u0438\u043F\u0438\u0442,
      \u043A\u0430\u043A \u043C\u043E\u0438 \u0441\u0443\u0441\u0442\u0430\u0432\u044B."
    - "\u0414\u0443\u0448\u0438 \u0434\u0443\u043C\u0430\u044E\u0442, \u0447\u0442\u043E
      \u044D\u0442\u043E \u043A\u0440\u0443\u0438\u0437? \u0425\u0430, \u043D\u0435\u0442,
      \u044D\u0442\u043E \u0431\u044E\u0434\u0436\u0435\u0442\u043D\u044B\u0439 \u0442\u0440\u0430\u043D\u0441\u0444\u0435\u0440."
    - "\u041C\u043E\u0436\u0435\u0442, \u0437\u0430\u0432\u0435\u0441\u0442\u0438
      \u043F\u043E\u0434\u043A\u0430\u0441\u0442? '\u041B\u043E\u0434\u043A\u0430
      \u0425\u0430\u0440\u043E\u043D\u0430: \u0418\u0441\u0442\u043E\u0440\u0438\u0438
      \u0438\u0437 \u0421\u0442\u0438\u043A\u0441\u0430'."
    - "\u0421\u043D\u043E\u0432\u0430 \u044D\u0442\u0438 \u043A\u0430\u043C\u043D\u0438!
      \u042F \u043D\u0435 \u043F\u043E\u043D\u044F\u043B, \u044D\u0442\u043E \u0447\u0442\u043E
      - \u0421\u0438\u0437\u0438\u0444 \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u043B\u0441\u044F?"
    - "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u043A\u043E\u043F\u0438\u0442\u044C
      \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043D\u0435\u0434\u043E\u043B\u0433\u043E.
      \u0422\u044B \u0436 \u043C\u043E\u044F \u043F\u0440\u0435\u043B\u0435\u0441\u0442\u044C!"
    - "\u041C\u043E\u0433 \u0431\u044B \u0441\u043A\u0430\u0437\u0430\u0442\u044C
      '\u042F \u0442\u0432\u043E\u0439 \u043E\u0442\u0435\u0446', \u043D\u043E \u0434\u0443\u0448\u0438
      \u0438 \u0442\u0430\u043A \u0432 \u0448\u043E\u043A\u0435."
    - "\u0412\u043E\u0442 \u0431\u044B \u0434\u0443\u0448\u0438 \u0445\u043E\u0442\u044C
      \u0440\u0430\u0437 \u0441\u043A\u0430\u0437\u0430\u043B\u0438: \xAB\u0421\u043F\u0430\u0441\u0438\u0431\u043E,
      \u0425\u0430\u0440\u043E\u043D, \u0445\u043E\u0440\u043E\u0448\u0438\u0439
      \u0440\u0435\u0439\u0441\xBB."
    - "\u0415\u0441\u043B\u0438 \u0443\u043F\u0430\u0434\u0451\u0442\u0435 \u2014
      \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0443."
    - "\u0414\u0443\u0448\u0438 \u2014 \u0445\u0443\u0434\u0448\u0438\u0435 \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u044B."
    - "\u0413\u0413, \u0434\u0443\u0448\u0438, \u0432\u044B \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u043B\u0438."
    - "\u0413\u0434\u0435 \u0447\u0430\u0435\u0432\u044B\u0435, \u0441\u043A\u0440\u044F\u0433\u0438?"
    - "\u0414\u0443\u0448 \u043C\u043D\u043E\u0433\u043E, \u0442\u0438\u0448\u0438\u043D\u044B
      \u043C\u0430\u043B\u043E."
    - "\u042D\u0442\u043E \u043C\u043E\u0439 \u0445\u0443\u0434\u0448\u0438\u0439
      \u0440\u0435\u0439\u0441."
    - "\u041B\u043E\u0434\u043E\u0447\u043D\u0438\u043A - \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u044F
      \u0432\u0435\u0447\u043D\u0430\u044F."
    - "\u041D\u043E\u0435\u0432 \u043A\u043E\u0432\u0447\u0435\u0433 \u0431\u044B\u043B
      \u043D\u0430\u0434\u0435\u0436\u043D\u0435\u0435."
    - "\u0416\u0438\u0437\u043D\u044C - \u0431\u043E\u043B\u044C. \u0421\u043C\u0435\u0440\u0442\u044C
      - \u0442\u043E\u0436\u0435."
    - "\u0412\u0440\u0435\u043C\u044F - \u043F\u043E\u043D\u044F\u0442\u0438\u0435
      \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435.
      \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u0442\u0443\u0442 \u0435\u0433\u043E
      \u043D\u0435\u0442."
    - "\u042F \u043D\u0435 \u0437\u043B\u043E\u0439 - \u044F \u0432\u0435\u0447\u043D\u044B\u0439."
    - "\u041C\u043E\u0436\u0435\u0442, \u0432\u0432\u0435\u0441\u0442\u0438 \u0430\u0431\u043E\u043D\u0435\u043C\u0435\u043D\u0442?"
    - "\u041E\u043F\u044F\u0442\u044C \u043D\u044B\u0442\u0438\u043A\u0438 \u043D\u0430
      \u0431\u043E\u0440\u0442\u0443..."
    - "\u041C\u043E\u0436\u0435\u0442, \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043F\u0440\u043E\u0446\u0435\u0441\u0441?"
    - "\u041C\u043E\u0436\u0435\u0442, \u0441\u043C\u0435\u043D\u0438\u0442\u044C
      \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u044E?"
    - "\u0413\u0434\u0435 \u043C\u043E\u044F \u043D\u043E\u0432\u0430\u044F \u043B\u043E\u0434\u043A\u0430?
      \u0412 DLC?"
    - "\u042F \u0442\u0432\u043E\u0439 \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u0447\u0438\u043A,
      \u041B\u044E\u043A"
    - "\u0425\u043E\u0442\u044C \u0431\u044B \u043E\u0434\u0438\u043D \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u044B\u0439
      \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440 \u043F\u043E\u043F\u0430\u043B\u0441\u044F..."
    - "\u042F \u043D\u0435 \u0437\u043B\u043E\u0439, \u044F \u043F\u0440\u043E\u0441\u0442\u043E
      \u0443\u0441\u0442\u0430\u0432\u0448\u0438\u0439"
    - "\u0413\u0434\u0435 \u043C\u043E\u0439 \u0431\u043E\u043D\u0443\u0441 \u0437\u0430
      \u0441\u0442\u0430\u0436? \u041A\u0430\u043A \u043D\u0435\u0442 \u0441\u0442\u0430\u0436\u0430?
      \u0410\u0445 \u0434\u0430..."
    - "\u0415\u0449\u0451 \u043E\u0434\u0438\u043D, \u043A\u0442\u043E \u0434\u0443\u043C\u0430\u0435\u0442,
      \u0447\u0442\u043E \u0437\u043D\u0430\u0435\u0442, \u043A\u0430\u043A \u043C\u043D\u0435
      \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C."
  - m_speechSituation: 0
    m_speechReplics:
    - "\u0412\u0430\u043C \u0448\u0430\u0448\u0435\u0447\u043A\u0438 \u0438\u043B\u0438
      \u0432\u0435\u0437\u0442\u0438?"
    - "\u0412\u0441\u0435 \u0434\u0443\u043C\u0430\u044E\u0442, \u0447\u0442\u043E
      \u044F \u043B\u044E\u0431\u043B\u044E \u0441\u0432\u043E\u044E \u0440\u0430\u0431\u043E\u0442\u0443
      -  \u0430 \u044F \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u043C\u043E\u0433\u0443
      \u0443\u0432\u043E\u043B\u0438\u0442\u044C\u0441\u044F."
    - "\u041B\u043E\u0434\u043A\u0430 \u0441\u0442\u0430\u0440\u0430\u044F, \u0432\u0451\u0441\u043B\u0430
      \u0441\u043A\u0440\u0438\u043F\u044F\u0442, \u0434\u0443\u0448\u0438 \u043D\u043E\u044E\u0442\u2026"
    - "\u042F\u0445\u0442\u0430\u2026 \u041F\u0430\u043B\u044C\u043C\u044B\u2026
      \u0418 \u043D\u0438 \u043E\u0434\u043D\u043E\u0439 \u0434\u0443\u0448\u0438
      \u0432 \u0442\u0440\u044E\u043C\u0435\u2026"
    - "\u041A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u044F
      \u0443\u043F\u043B\u044B\u0432\u0443. \u041A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C\u2026"
    - "\u042F\u0445\u0442\u0430 \u043C\u043E\u0435\u0439 \u043C\u0435\u0447\u0442\u044B
      \u0434\u0430\u0436\u0435 \u043D\u0435 \u0437\u043D\u0430\u0435\u0442, \u0447\u0442\u043E
      \u044F \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E."
    - "\u0411\u0435\u0437\u0432\u0440\u0435\u043C\u0435\u043D\u044C\u0435 \u2014
      \u044D\u0442\u043E \u043A\u043E\u0433\u0434\u0430 \xAB\u0441\u043A\u043E\u0440\u043E\xBB
      \u0438 \xAB\u043D\u0438\u043A\u043E\u0433\u0434\u0430\xBB \u2014 \u043E\u0434\u043D\u043E
      \u0438 \u0442\u043E \u0436\u0435."
    - "\u0418\u043D\u043E\u0433\u0434\u0430 \u044F \u0441\u0442\u0430\u0432\u043B\u044E
      \u043F\u0435\u0441\u043E\u0447\u043D\u044B\u0435 \u0447\u0430\u0441\u044B\u2026
      \u043F\u0440\u043E\u0441\u0442\u043E \u0434\u043B\u044F \u0434\u0435\u043A\u043E\u0440\u0430."
    - "\u0412\u0435\u0447\u043D\u043E\u0441\u0442\u044C \u2014 \u044D\u0442\u043E
      \u043A\u043E\u0433\u0434\u0430 \u0442\u044B \u0443\u0436\u0435 \u0437\u0430\u0431\u044B\u043B,
      \u0447\u0442\u043E \u0442\u0430\u043A\u043E\u0435 \xAB\u0436\u0434\u0430\u0442\u044C\xBB."
    - "\u041E\u043D \u0443\u043C\u0435\u0440 \u043E\u0442 \u0447\u0435\u0433\u043E?
      \u041E\u0442 \u0436\u0430\u0434\u043D\u043E\u0441\u0442\u0438? \u041E, \u0441\u044E\u0440\u043F\u0440\u0438\u0437."
    - "\u041F\u043E\u0447\u0435\u043C\u0443 \u0432\u0441\u0435 \u0434\u0443\u0448\u0438
      \u0442\u0430\u043A\u0438\u0435\u2026 \u043B\u0438\u043F\u043A\u0438\u0435?"
    - "\u042F \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0441\u0442\u0430\u0440
      \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E\u2026 \u0410 \u043D\u0435\u0442,
      \u044F \u0431\u0435\u0441\u0441\u043C\u0435\u0440\u0442\u0435\u043D."
    - "\u041C\u0435\u043D\u044F \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0446\u0435\u043D\u0438\u0442.
      \u0414\u0430\u0436\u0435 \u0426\u0435\u0440\u0431\u0435\u0440."
    - "\u0418\u043D\u043E\u0433\u0434\u0430 \u044F \u0436\u0430\u043B\u0435\u044E,
      \u0447\u0442\u043E \u043D\u0435 \u043C\u043E\u0433\u0443 \u0443\u043C\u0435\u0440\u0435\u0442\u044C."
    - "\u0427\u0442\u043E \u0442\u044F\u0436\u0435\u043B\u0435\u0435: \u0434\u0443\u0448\u0430
      \u0433\u0440\u0435\u0448\u043D\u0438\u043A\u0430 \u0438\u043B\u0438 \u043C\u043E\u0451
      \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0435?"
    - "\u0415\u0441\u043B\u0438 \u044F \u0437\u0430\u043A\u0440\u043E\u044E \u0433\u043B\u0430\u0437\u0430,
      \u043C\u043E\u0436\u0435\u0442, \u043E\u043D\u0438 \u0432\u0441\u0435 \u0438\u0441\u0447\u0435\u0437\u043D\u0443\u0442?"
    - "\u041F\u043E\u0447\u0435\u043C\u0443 \u0443 \u0432\u0441\u0435\u0445 \u0434\u0443\u0448
      \u0435\u0441\u0442\u044C \u0432\u043E\u043F\u0440\u043E\u0441\u044B? \u0423
      \u043C\u0435\u043D\u044F \u043D\u0435\u0442 \u043E\u0442\u0432\u0435\u0442\u043E\u0432!"
    - "\u0415\u0441\u043B\u0438 \u0431\u044B \u0443 \u043C\u0435\u043D\u044F \u0431\u044B\u043B
      \u0432\u044B\u0431\u043E\u0440, \u044F \u0431\u044B \u0432\u044B\u0431\u0440\u0430\u043B\u2026
      \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0435."
    - "\u042F \u0443\u0441\u0442\u0430\u043B, \u0431\u043E\u0441\u0441. \u041F\u0440\u043E\u0441\u0442\u043E
      \u0443\u0441\u0442\u0430\u043B."
    - "\u0416\u0438\u0437\u043D\u044C \u2014 \u043A\u0430\u043A \u043B\u043E\u0434\u043A\u0430:
      \u0442\u043E\u043D\u0435\u0442 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E,
      \u043D\u043E \u0432\u0435\u0440\u043D\u043E."
    - "\u0414\u0435\u0440\u0436\u0438 \u0434\u0440\u0443\u0437\u0435\u0439 \u0431\u043B\u0438\u0437\u043A\u043E,
      \u0430 \u0434\u0443\u0448\u0438 \u2014 \u0435\u0449\u0451 \u0431\u043B\u0438\u0436\u0435.
      \u0412 \u043B\u043E\u0434\u043A\u0435."
    - "\u0414\u0443\u0448\u0438. \u0414\u0443\u0448\u0438 \u043D\u0438\u043A\u043E\u0433\u0434\u0430
      \u043D\u0435 \u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F\u2026"
    - "\u0418\u043B\u0438 \u044F \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u0447\u0438\u043A,
      \u0438\u043B\u0438 \u043C\u043D\u0435 \u044D\u0442\u043E \u0441\u043D\u0438\u0442\u0441\u044F."
    - "\u042F \u0441\u0442\u0430\u043B \u0441\u043C\u0435\u0440\u0442\u044C\u044E,
      \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u0442\u0435\u043B\u0435\u043C\u2026
      \u0442\u0430\u043A\u0441\u0438\u0441\u0442\u043E\u043C."
    - "\u0418 \u043F\u043E\u043D\u0435\u0441\u043B\u0430\u0441\u044C \u0434\u0443\u0448\u0430
      \u043D\u0430 \u0434\u043D\u043E\u2026"
    - "\u042F \u043C\u044B\u0441\u043B\u044E \u2014 \u0437\u043D\u0430\u0447\u0438\u0442,
      \u044F \u0443\u0441\u0442\u0430\u043B."
    - "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439 \u0442\u044C\u043C\u0430,
      \u043C\u043E\u0439 \u0441\u0442\u0430\u0440\u044B\u0439 \u0434\u0440\u0443\u0433\u2026"
    - "\u042F \u043D\u0435 \u0436\u0438\u0432\u0443. \u042F \u043F\u0440\u043E\u0441\u0442\u043E\u2026
      \u043D\u0435 \u0443\u0445\u043E\u0436\u0443."
    - "\u042F \u043A\u0430\u043A Wi-Fi \u0432 \u043C\u0435\u0442\u0440\u043E: \u0432\u0441\u0435
      \u043C\u043D\u043E\u0439 \u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F,
      \u043D\u043E \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442."
    - "\u041B\u0443\u0447\u0448\u0438\u0439 \u0434\u0435\u043D\u044C \u0432 \u043C\u043E\u0435\u0439
      \u0432\u0435\u0447\u043D\u043E\u0441\u0442\u0438? \u0422\u043E\u0442, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u043D\u0435 \u0431\u044B\u043B\u043E."
    - "\u042F\u0445\u0442\u0430, \u043F\u0430\u043B\u044C\u043C\u044B, \u043A\u043E\u043A\u043E\u0441\u044B\u2026
      \u0410 \u043F\u043E\u043A\u0430 \u2014 \u0433\u0440\u0435\u0431\u0443, \u043A\u0430\u043A
      \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u044B\u0439."
    - "\u041B\u043E\u0434\u043A\u0430 \u0434\u044B\u0440\u044F\u0432\u0430\u044F,
      \u043A\u0430\u043A \u043C\u043E\u044F \u043C\u043E\u0442\u0438\u0432\u0430\u0446\u0438\u044F."
    - "\u0415\u0441\u043B\u0438 \u0431\u044B \u0434\u0443\u0448\u0438 \u0431\u044B\u043B\u0438
      \u0442\u0438\u0448\u0435, \u044F \u0431\u044B, \u043C\u043E\u0436\u0435\u0442,
      \u0438 \u043D\u0435 \u0437\u043B\u0438\u043B\u0441\u044F."
    - "\u0414\u0443\u0448\u0438 \u043D\u043E\u044E\u0442 \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u0438\u0433\u0440\u043E\u043A\u0438 \u043D\u0430 \u0444\u043E\u0440\u0443\u043C\u0430\u0445."
    - "\u0415\u0441\u043B\u0438 \u0431\u044B \u044F \u043F\u043E\u043B\u0443\u0447\u0430\u043B
      \u043C\u043E\u043D\u0435\u0442\u043A\u0443 \u0437\u0430 \u043A\u0430\u0436\u0434\u0443\u044E
      \u0436\u0430\u043B\u043E\u0431\u0443..."
    - "\u041B\u043E\u0434\u043A\u0430 \u0441\u043A\u0440\u0438\u043F\u0438\u0442,
      \u043A\u0430\u043A \u043C\u043E\u0438 \u0441\u0443\u0441\u0442\u0430\u0432\u044B."
    - "\u0414\u0443\u0448\u0438 \u0434\u0443\u043C\u0430\u044E\u0442, \u0447\u0442\u043E
      \u044D\u0442\u043E \u043A\u0440\u0443\u0438\u0437? \u0425\u0430, \u043D\u0435\u0442,
      \u044D\u0442\u043E \u0431\u044E\u0434\u0436\u0435\u0442\u043D\u044B\u0439 \u0442\u0440\u0430\u043D\u0441\u0444\u0435\u0440."
    - "\u041C\u043E\u0436\u0435\u0442, \u0437\u0430\u0432\u0435\u0441\u0442\u0438
      \u043F\u043E\u0434\u043A\u0430\u0441\u0442? '\u041B\u043E\u0434\u043A\u0430
      \u0425\u0430\u0440\u043E\u043D\u0430: \u0418\u0441\u0442\u043E\u0440\u0438\u0438
      \u0438\u0437 \u0421\u0442\u0438\u043A\u0441\u0430'."
    - "\u0421\u043D\u043E\u0432\u0430 \u044D\u0442\u0438 \u043A\u0430\u043C\u043D\u0438!
      \u042F \u043D\u0435 \u043F\u043E\u043D\u044F\u043B, \u044D\u0442\u043E \u0447\u0442\u043E
      - \u0421\u0438\u0437\u0438\u0444 \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u043B\u0441\u044F?"
    - "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u043A\u043E\u043F\u0438\u0442\u044C
      \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043D\u0435\u0434\u043E\u043B\u0433\u043E.
      \u0422\u044B \u0436 \u043C\u043E\u044F \u043F\u0440\u0435\u043B\u0435\u0441\u0442\u044C!"
    - "\u041C\u043E\u0433 \u0431\u044B \u0441\u043A\u0430\u0437\u0430\u0442\u044C
      '\u042F \u0442\u0432\u043E\u0439 \u043E\u0442\u0435\u0446', \u043D\u043E \u0434\u0443\u0448\u0438
      \u0438 \u0442\u0430\u043A \u0432 \u0448\u043E\u043A\u0435."
    - "\u0412\u043E\u0442 \u0431\u044B \u0434\u0443\u0448\u0438 \u0445\u043E\u0442\u044C
      \u0440\u0430\u0437 \u0441\u043A\u0430\u0437\u0430\u043B\u0438: \xAB\u0421\u043F\u0430\u0441\u0438\u0431\u043E,
      \u0425\u0430\u0440\u043E\u043D, \u0445\u043E\u0440\u043E\u0448\u0438\u0439
      \u0440\u0435\u0439\u0441\xBB."
    - "\u0415\u0441\u043B\u0438 \u0443\u043F\u0430\u0434\u0451\u0442\u0435 \u2014
      \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0443."
    - "\u0414\u0443\u0448\u0438 \u2014 \u0445\u0443\u0434\u0448\u0438\u0435 \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u044B."
    - "\u0413\u0413, \u0434\u0443\u0448\u0438, \u0432\u044B \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u043B\u0438."
    - "\u0413\u0434\u0435 \u0447\u0430\u0435\u0432\u044B\u0435, \u0441\u043A\u0440\u044F\u0433\u0438?"
    - "\u0414\u0443\u0448 \u043C\u043D\u043E\u0433\u043E, \u0442\u0438\u0448\u0438\u043D\u044B
      \u043C\u0430\u043B\u043E."
    - "\u042D\u0442\u043E \u043C\u043E\u0439 \u0445\u0443\u0434\u0448\u0438\u0439
      \u0440\u0435\u0439\u0441."
    - "\u041B\u043E\u0434\u043E\u0447\u043D\u0438\u043A - \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u044F
      \u0432\u0435\u0447\u043D\u0430\u044F."
    - "\u041D\u043E\u0435\u0432 \u043A\u043E\u0432\u0447\u0435\u0433 \u0431\u044B\u043B
      \u043D\u0430\u0434\u0435\u0436\u043D\u0435\u0435."
    - "\u0416\u0438\u0437\u043D\u044C - \u0431\u043E\u043B\u044C. \u0421\u043C\u0435\u0440\u0442\u044C
      - \u0442\u043E\u0436\u0435."
    - "\u0412\u0440\u0435\u043C\u044F - \u043F\u043E\u043D\u044F\u0442\u0438\u0435
      \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435.
      \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u0442\u0443\u0442 \u0435\u0433\u043E
      \u043D\u0435\u0442."
    - "\u042F \u043D\u0435 \u0437\u043B\u043E\u0439 - \u044F \u0432\u0435\u0447\u043D\u044B\u0439."
    - "\u041C\u043E\u0436\u0435\u0442, \u0432\u0432\u0435\u0441\u0442\u0438 \u0430\u0431\u043E\u043D\u0435\u043C\u0435\u043D\u0442?"
    - "\u041E\u043F\u044F\u0442\u044C \u043D\u044B\u0442\u0438\u043A\u0438 \u043D\u0430
      \u0431\u043E\u0440\u0442\u0443..."
    - "\u041C\u043E\u0436\u0435\u0442, \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043F\u0440\u043E\u0446\u0435\u0441\u0441?"
    - "\u041C\u043E\u0436\u0435\u0442, \u0441\u043C\u0435\u043D\u0438\u0442\u044C
      \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u044E?"
    - "\u0413\u0434\u0435 \u043C\u043E\u044F \u043D\u043E\u0432\u0430\u044F \u043B\u043E\u0434\u043A\u0430?
      \u0412 DLC?"
    - "\u042F \u0442\u0432\u043E\u0439 \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u0447\u0438\u043A,
      \u041B\u044E\u043A"
    - "\u0425\u043E\u0442\u044C \u0431\u044B \u043E\u0434\u0438\u043D \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u044B\u0439
      \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440 \u043F\u043E\u043F\u0430\u043B\u0441\u044F..."
    - "\u042F \u043D\u0435 \u0437\u043B\u043E\u0439, \u044F \u043F\u0440\u043E\u0441\u0442\u043E
      \u0443\u0441\u0442\u0430\u0432\u0448\u0438\u0439"
    - "\u0413\u0434\u0435 \u043C\u043E\u0439 \u0431\u043E\u043D\u0443\u0441 \u0437\u0430
      \u0441\u0442\u0430\u0436? \u041A\u0430\u043A \u043D\u0435\u0442 \u0441\u0442\u0430\u0436\u0430?
      \u0410\u0445 \u0434\u0430..."
    - "\u0415\u0449\u0451 \u043E\u0434\u0438\u043D, \u043A\u0442\u043E \u0434\u0443\u043C\u0430\u0435\u0442,
      \u0447\u0442\u043E \u0437\u043D\u0430\u0435\u0442, \u043A\u0430\u043A \u043C\u043D\u0435
      \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C."
