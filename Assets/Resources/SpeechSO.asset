  m_Script: {fileID: 11500000, guid: 67431e63601e44edbfbf7726f649ec43, type: 3}
  m_Name: SpeechSO
  m_EditorClassIdentifier: 
  m_speechReplics:
  - m_speechSituation: 0
    m_speechReplics:
    - "\u041A\u0442\u043E \u043A\u0440\u0430\u0439\u043D\u0438\u0439?"
    - "\u041E\u0439, \u0430 \u044F \u0443\u0436\u0435 \u0442\u0443\u0442 \u0437\u0430\u043D\u0438\u043C\u0430\u043B!"
    - "\u041C\u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C!"
  - m_speechSituation: 1
    m_speechReplics:
    - "\u041C\u044B \u0443\u0436\u0435 \u043F\u0440\u0438\u0435\u0445\u0430\u043B\u0438?"
    - "\u0410 \u0442\u0443\u0442 \u0435\u0441\u0442\u044C \u0431\u043B\u044E\u0442\u0443\u0441?"
    - "\u0410 \u043C\u043E\u0436\u043D\u043E \u0444\u043E\u0440\u0442\u043E\u0447\u043A\u0443
      \u043F\u0440\u0438\u043A\u0440\u044B\u0442\u044C?"
  - m_speechSituation: 2
    m_speechReplics:
    - "\u041C\u043D\u0435 \u043D\u0435 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u043E\u0441\u044C,
      \u0434\u0438\u043B\u0430\u0439\u043A!"
    - "\u0411\u0443\u0434\u0443 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u043E\u0432\u0430\u0442\u044C
      \u0432\u0430\u0441!"
    - "\u041D\u0443 \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u0442\u043E!"
