  m_Script: {fileID: 11500000, guid: 1c2056bfafc94c47bf6960a72405a593, type: 3}
  m_Name: Feedback
  m_EditorClassIdentifier: 
  feedbacks:
  - message: "\u041F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u043E\u0441\u044C!
      \u0425\u043E\u0442\u044F \u0441\u043E\u0441\u0435\u0434 \u0432\u0435\u0447\u043D\u043E
      \u043E\u0440\u0430\u043B: \xAB\u042F \u043D\u0435 \u0434\u043E\u043B\u0436\u0435\u043D
      \u0431\u044B\u043B \u0443\u043C\u0438\u0440\u0430\u0442\u044C!\xBB \u2014 \u0438\u0441\u043F\u043E\u0440\u0442\u0438\u043B
      \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0443.!"
    starCount: 4
  - message: "\u0425\u0430\u0440\u043E\u043D \u043E\u0431\u0435\u0449\u0430\u043B
      \xAB\u043D\u0435\u0437\u0430\u0431\u044B\u0432\u0430\u0435\u043C\u043E\u0435
      \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435\xBB. \u041D\u0443,
      \u044F \u0435\u0433\u043E \u0442\u043E\u0447\u043D\u043E \u043D\u0435 \u0437\u0430\u0431\u0443\u0434\u0443\u2026"
    starCount: 1
  - message: "\u041D\u0435\u0442 \u043A\u0432\u0435\u0441\u0442-\u043C\u0430\u0440\u043A\u0435\u0440\u043E\u0432,
      \u043A\u0430\u0440\u0442\u044B, \u0434\u0430 \u0438 \u0432\u043E\u043E\u0431\u0449\u0435
      \u2014 \u043A\u0443\u0434\u0430 \u044F \u043F\u043B\u044B\u0432\u0443?!"
    starCount: 0
  - message: "\u0414\u0430\u0436\u0435 \u0432 \u0438\u0433\u0440\u0435 \u043F\u0440\u043E
      \u043F\u0442\u0438\u0447\u043A\u0443 \u0431\u044B\u043B\u043E \u043F\u0440\u043E\u0449\u0435
      \u043F\u0440\u043E\u043B\u0435\u0442\u0435\u0442\u044C, \u0447\u0435\u043C
      \u0442\u0443\u0442 \u043F\u0440\u043E\u043F\u043B\u044B\u0442\u044C."
    starCount: 2
  - message: "\u0411\u044B\u0441\u0442\u0440\u043E, \u043D\u043E \u043C\u0440\u0430\u0447\u043D\u043E.
      \u041C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u0445\u043E\u0442\u044F
      \u0431\u044B \xAB\u0422\u0430\u043D\u0446\u0443\u044E\u0449\u0438\u0445 \u0441\u043A\u0435\u043B\u0435\u0442\u043E\u0432\xBB
      \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C."
    starCount: 4
  - message: "\u0414\u0430\u0436\u0435 \u0432 \xAB\u041C\u043E\u0440\u0441\u043A\u043E\u043C
      \u0431\u043E\u044E\xBB \u0431\u043E\u043B\u044C\u0448\u0435 \u044D\u043A\u0448\u0435\u043D\u0430!"
    starCount: 0
  - message: "1 \u0437\u0432\u0435\u0437\u0434\u0430, \u043F\u043E\u0442\u043E\u043C\u0443
      \u0447\u0442\u043E \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u043D\u0435
      \u043F\u0443\u0441\u043A\u0430\u044E\u0442. \u0425\u043E\u0447\u0443 \u043C\u0435\u043D\u0435\u0434\u0436\u0435\u0440\u0430!"
    starCount: 1
  - message: "\u0425\u0430\u0440\u043E\u043D \u2014 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439,
      \u043A\u0442\u043E \u0443\u043C\u0443\u0434\u0440\u0438\u043B\u0441\u044F \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C
      \u0434\u0443\u0448\u0443 \u0432 \u0442\u0440\u0451\u0445\u043C\u0435\u0442\u0440\u043E\u0432\u043E\u0439
      \u043B\u043E\u0434\u043A\u0435."
    starCount: 1
  - message: "\u041F\u043B\u044B\u043B, \u0434\u0443\u043C\u0430\u043B \u043E \u0436\u0438\u0437\u043D\u0438\u2026
      \u041F\u043E\u0442\u043E\u043C \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043B,
      \u0447\u0442\u043E \u043E\u043D\u0430 \u0443\u0436\u0435 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0430\u0441\u044C."
    starCount: 3
  - message: "\u0414\u0430\u0436\u0435 \u0441\u0435\u0440\u0432\u0435\u0440\u044B
      Noobisoft \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442 \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u0435\u0435!"
    starCount: 0
  - message: "\u042D\u0442\u043E \u043D\u0435 \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0430,
      \u044D\u0442\u043E early access \u043A\u0430\u043A\u043E\u0439-\u0442\u043E.
      \u0425\u043E\u0447\u0443 \u0440\u0435\u0444\u0430\u043D\u0434!"
    starCount: 1
  - message: "\u0425\u0430\u0440\u043E\u043D \u2014 \u044D\u0442\u043E \u043A\u0430\u043A
      \u0442\u0438\u043C\u043C\u0435\u0439\u0442 \u0432 \u0441\u043E\u043B\u043E-\u0440\u0430\u043D\u0433\u0435:
      \u0432\u0435\u0447\u043D\u043E \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u0435\u043D
      \u0438 \u0434\u0435\u043D\u0435\u0433 \u043F\u0440\u043E\u0441\u0438\u0442."
    starCount: 1
  - message: "\u042F \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B \u043C\u043E\u043D\u0435\u0442\u043E\u0439,
      \u0430 \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u043E\u043F\u044B\u0442
      \u043A\u0430\u043A \u0432 F2P-\u0438\u0433\u0440\u0435: pay-to-lose."
    starCount: 1
  - message: "\u041D\u0438\u043A\u0430\u043A\u043E\u0433\u043E \u043B\u0443\u0442\u0431\u043E\u043A\u0441\u0430
      \u0432 \u043A\u043E\u043D\u0446\u0435. \u041E\u0431\u043C\u0430\u043D!"
    starCount: 0
  - message: "\u041D\u0435\u0442 \u043E\u043F\u0446\u0438\u0438 \xABNew Game+\xBB.
      \u0425\u043E\u0447\u0443 \u0440\u0435\u0441\u0442\u0430\u0440\u0442!"
    starCount: 0
  - message: "\u042F \u0434\u0443\u043C\u0430\u043B, \u0431\u0443\u0434\u0435\u0442
      \u043A\u0430\u043A \u0432 \u0442\u043E\u043F\u043E\u0432\u043E\u0439 \u0438\u0433\u0440\u0435,
      \u0430 \u043F\u043E\u043B\u0443\u0447\u0438\u043B \xAB\u0410\u0432\u0442\u043E\u0431\u0443\u0441
      \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435\xBB \u043A\u0430\u043A\u043E\u0439-\u0442\u043E."
    starCount: 0
  - message: "\u041D\u0438\u043A\u0430\u043A\u043E\u0433\u043E \u043A\u0438\u043D\u0435\u043C\u0430\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0447\u043D\u043E\u0433\u043E
      \u0444\u0438\u043D\u0430\u043B\u0430. \u041F\u0440\u043E\u0441\u0442\u043E
      \u0442\u044C\u043C\u0430."
    starCount: 0
  - message: "\u041A\u043E\u043D\u0434\u0443\u043A\u0442\u043E\u0440 \u0445\u043C\u0443\u0440\u044B\u0439,
      \u043C\u0443\u0437\u044B\u043A\u0443 \u043D\u0435 \u0432\u043A\u043B\u044E\u0447\u0438\u043B,
      \u0434\u0430\u0436\u0435 \u0422\u0438\u0442\u0430\u043D\u0438\u043A\u0430 \u043D\u0435
      \u0441\u044B\u0433\u0440\u0430\u043B\u2026"
    starCount: 2
  - message: "\u041F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u043E\u0441\u044C!
      \u0425\u043E\u0442\u044F \u0441\u043E\u0441\u0435\u0434 \u0432\u0435\u0447\u043D\u043E
      \u043E\u0440\u0430\u043B: \xAB\u042F \u043D\u0435 \u0434\u043E\u043B\u0436\u0435\u043D
      \u0431\u044B\u043B \u0443\u043C\u0438\u0440\u0430\u0442\u044C!\xBB \u2014 \u0438\u0441\u043F\u043E\u0440\u0442\u0438\u043B
      \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0443."
    starCount: 4
  - message: "\u0411\u044B\u0441\u0442\u0440\u043E, \u0431\u0435\u0437 \u0441\u043C\u0441
      \u0438 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438.
      \u041D\u043E \u043E\u0431\u0440\u0430\u0442\u043D\u044B\u0439 \u0431\u0438\u043B\u0435\u0442
      \u043D\u0435 \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D."
    starCount: 5
  - message: "\u041B\u0443\u0447\u0448\u0438\u0439 \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u0447\u0438\u043A!
      \u041F\u0440\u0430\u0432\u0434\u0430, \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432
      \u043D\u0435\u0442\u2026"
    starCount: 5
  - message: "\u0411\u044B\u0441\u0442\u0440\u043E, \u043D\u043E \u043C\u0440\u0430\u0447\u043D\u043E.
      \u041C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u0445\u043E\u0442\u044F
      \u0431\u044B \u0441\u0432\u0435\u0442\u043B\u044F\u0447\u043A\u043E\u0432 \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C?"
    starCount: 4
  - message: "\u0414\u0430\u0436\u0435 \u043C\u0443\u0437\u044B\u043A\u0438 \u043D\u0435\u0442.
      \u0422\u0438\u0448\u0438\u043D\u0430. \u0422\u043E\u043B\u044C\u043A\u043E
      \u0441\u0442\u043E\u043D\u044B."
    starCount: 0
  - message: "\u041B\u043E\u0434\u043A\u0430 \u0441\u0442\u0430\u0440\u0430\u044F,
      \u0432\u043E\u0434\u0430 \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F,
      \u0441\u043E\u0441\u0435\u0434 \u0432\u043E\u043D\u044F\u0435\u0442 \u0441\u0435\u0440\u043E\u0439\u2026"
    starCount: 2
  - message: "\u0411\u044B\u0441\u0442\u0440\u043E, \u043D\u043E \u043C\u0440\u0430\u0447\u043D\u043E.
      \u041C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u0445\u043E\u0442\u044F
      \u0431\u044B \xAB\u0422\u0430\u043D\u0446\u0443\u044E\u0449\u0438\u0445 \u0441\u043A\u0435\u043B\u0435\u0442\u043E\u0432\xBB
      \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C."
    starCount: 4
  - message: "\u0414\u0430\u0436\u0435 \u043B\u043E\u0434\u043A\u0430 \u0441\u043A\u0440\u0438\u043F\u0438\u0442
      \u043A\u0430\u043A \u0434\u0443\u0448\u0438 \u0433\u0440\u0435\u0448\u043D\u0438\u043A\u043E\u0432."
    starCount: 0
  - message: "\u0425\u0443\u0434\u0448\u0438\u0439 \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442!
      \u0412 Aow \u044E\u043D\u0438\u0442\u044B \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u044E\u0442\u0441\u044F
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435."
    starCount: 0
  - message: "\u0425\u0430\u0440\u043E\u043D \u2014 \u044D\u0442\u043E \u043A\u0430\u043A
      \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0438\u0439 \u0440\u0430\u043D\u0434\u043E\u043C:
      \u043B\u0438\u0431\u043E \u043C\u043E\u043B\u0447\u0438\u0442, \u043B\u0438\u0431\u043E
      \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435."
    starCount: 1
  - message: "\u0425\u0443\u0434\u0448\u0430\u044F \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044F!
      \u0414\u0430\u0436\u0435 \u043D\u043E\u0432\u0438\u0447\u043A\u0438 \u0432
      WL \u043B\u0443\u0447\u0448\u0435 \u043F\u043B\u0430\u043D\u0438\u0440\u0443\u044E\u0442
      \u0430\u0442\u0430\u043A\u0438, \u0447\u0435\u043C \u044D\u0442\u043E\u0442
      \"\u043F\u0435\u0440\u0435\u0432\u043E\u0437\u0447\u0438\u043A\"."
    starCount: 0
  - message: "\u041B\u043E\u0434\u043A\u0430 \u0441\u043A\u0440\u0438\u043F\u0438\u0442,
      \u0425\u0430\u0440\u043E\u043D \u043C\u043E\u043B\u0447\u0438\u0442, \u043D\u0438\u043A\u0430\u043A\u043E\u0433\u043E
      \u0441\u0435\u0440\u0432\u0438\u0441\u0430! \u0413\u0434\u0435 \u043C\u043E\u0439
      VIP-\u043A\u0430\u0442\u0435\u0440?"
    starCount: 1
  - message: "\u041D\u0443 \u0445\u043E\u0442\u044C \u0442\u0443\u0442 \u043D\u0435
      \u0441\u0442\u0430\u0432\u044F\u0442 \u044D\u0442\u0443 \u0441\u0442\u0440\u0451\u043C\u043D\u0443\u044E
      \u043C\u0443\u0437\u044B\u043A\u0443! \u0421\u043F\u0430\u0441\u0438\u0431\u043E,
      \u0425\u0430\u0440\u043E\u043D, \u043E\u0442 \u0434\u0443\u0448\u0438!"
    starCount: 5
  - message: "\u041D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E \u0434\u043E\u0432\u0451\u0437,
      \u043D\u043E \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043F\u0435\u0442\u044C
      \u043A\u0430\u0440\u0430\u043E\u043A\u0435. \u0412\u0435\u0447\u043D\u043E\u0441\u0442\u044C
      \u0441\u043A\u0443\u0447\u043D\u0430\u044F!"
    starCount: 3
  - message: "\u0411\u044B\u0441\u0442\u0440\u043E, \u043D\u043E \u043C\u043E\u0439
      \u043D\u0435\u043A\u0440\u043E\u043B\u043E\u0433 \u2014 \u043E\u0442\u0441\u0442\u043E\u0439.
      \u041E\u0431\u0438\u0434\u043D\u043E."
    starCount: 4
  - message: "\u0425\u043E\u0442\u0435\u043B \u0432 \u0440\u0430\u0439, \u0430 \u043C\u0435\u043D\u044F
      \u0432\u0435\u0437\u0443\u0442 \u0432 \u0411\u0435\u0437\u0432\u0440\u0435\u043C\u0435\u043D\u044C\u0435!
      \u0412\u043E\u0434\u0438\u0442\u0435\u043B\u044C \u0438\u0433\u043D\u043E\u0440\u0438\u0440\u0443\u0435\u0442
      \u043D\u0430\u0432\u0438\u0433\u0430\u0442\u043E\u0440!"
    starCount: 1
  - message: "\u0412 \u043B\u043E\u0434\u043A\u0435 \u043D\u0435\u0442 Wi-Fi, \u0430
      \u044F \u0445\u043E\u0442\u0435\u043B \u0437\u0430\u043F\u043E\u0441\u0442\u0438\u0442\u044C
      \u0441\u0435\u043B\u0444\u0438 \u0441\u043E \u0421\u0442\u0438\u043A\u0441\u0430.
      \u0420\u0430\u0437\u043E\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0438\u0435."
    starCount: 2
  - message: "\u0413\u0440\u0435\u0431\u0451\u0442 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E,
      \u043D\u043E \u0432\u0441\u044E \u0434\u043E\u0440\u043E\u0433\u0443 \u043C\u043E\u043B\u0447\u0438\u0442.
      \u041C\u0440\u0430\u0447\u043D\u043E."
    starCount: 3
  - message: "\u041F\u0440\u043E\u043B\u0438\u043B \u043C\u043D\u0435 \u043D\u0430
      \u043D\u043E\u0433\u0443 \u0440\u0435\u0447\u043D\u0443\u044E \u0432\u043E\u0434\u0443!
      \u0413\u0434\u0435 \u0438\u0437\u0432\u0438\u043D\u0435\u043D\u0438\u044F?"
    starCount: 1
  - message: "\u041F\u043E\u0435\u0437\u0434\u043A\u0430 \u043E\u0433\u043E\u043D\u044C,
      \u043D\u043E \u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C \u043D\u0435
      \u0434\u0430\u043B \u043F\u043E\u0442\u0440\u043E\u0433\u0430\u0442\u044C \u0432\u0435\u0441\u043B\u043E.
      \u0416\u0430\u0434\u0438\u043D\u0430."
    starCount: 4
  - message: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043F\u043B\u044B\u043B, \u044F \u043E\u043F\u043E\u0437\u0434\u0430\u043B
      \u043D\u0430 \u0441\u0443\u0434 \u0410\u0438\u0434\u0430! \u041C\u0438\u043D\u0443\u0441
      \u0431\u0430\u043B\u043B."
    starCount: 2
  - message: "\u041B\u0443\u0447\u0448\u0438\u0439 \u043B\u043E\u0434\u043E\u0447\u043D\u0438\u043A,
      \u0445\u043E\u0442\u044C \u0438 \u043C\u043E\u043B\u0447\u0438\u0442! \u041F\u044F\u0442\u044C
      \u0437\u0432\u0451\u0437\u0434."
    starCount: 5
  - message: "\u0414\u043E\u0432\u0451\u0437 \u0431\u0435\u0437 \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0439,
      \u043D\u043E \u043C\u0443\u0437\u044B\u043A\u0438 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442.
      \u0425\u043E\u0447\u0443 \u043F\u043B\u0435\u0439\u043B\u0438\u0441\u0442 \u0411\u0435\u0437\u0432\u0440\u0435\u043C\u0435\u043D\u044C\u044F!"
    starCount: 3
  - message: "\u041B\u043E\u0434\u043A\u0430 \u0442\u0435\u0441\u043D\u0430\u044F,
      \u0430 \u044F \u0431\u043E\u0433\u0430\u0447, \u043C\u043D\u0435 \u043D\u0443\u0436\u0435\u043D
      \u043A\u043E\u043C\u0444\u043E\u0440\u0442!"
    starCount: 1
  - message: "\u041B\u043E\u0434\u043A\u0430 \u0448\u0430\u0442\u0430\u043B\u0430\u0441\u044C,
      \u0447\u0443\u0442\u044C \u043D\u0435 \u0443\u0442\u043E\u043D\u0443\u043B
      \u0432\u0442\u043E\u0440\u043E\u0439 \u0440\u0430\u0437!"
    starCount: 2
  - message: "\u041D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E, \u043D\u043E
      \u0432 \u0421\u0442\u0438\u043A\u0441\u0435 \u0432\u043E\u043D\u044F\u0435\u0442
      \u0442\u0438\u043D\u043E\u0439. \u041F\u043E\u0440\u0430 \u043C\u044B\u0442\u044C
      \u0440\u0435\u043A\u0443!"
    starCount: 3
  - message: "\u041E\u0442\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u043A\u0440\u044E\u043A \u0434\u043E \u042D\u043B\u0438\u0437\u0438\u0443\u043C\u0430!
      \u0421\u0435\u0440\u0432\u0438\u0441 \u043D\u0443\u043B\u0435\u0432\u043E\u0439."
    starCount: 1
  - message: "\u0414\u043E\u0432\u0451\u0437 \u0431\u0435\u0437 \u043F\u0440\u043E\u0431\u043B\u0435\u043C,
      \u043D\u043E \u0432 \u043B\u043E\u0434\u043A\u0435 \u043D\u0435\u0442 \u043F\u043E\u0434\u0441\u0442\u0430\u043A\u0430\u043D\u043D\u0438\u043A\u0430.
      \u041A\u043E\u0444\u0435 \u043F\u0440\u043E\u043B\u0438\u043B."
    starCount: 3
  - message: "\u041B\u0443\u0447\u0448\u0430\u044F \u043F\u043E\u0435\u0437\u0434\u043A\u0430
      \u0432 \u0437\u0430\u0433\u0440\u043E\u0431\u043A\u0435! \u0423\u0441\u043F\u0435\u043B\u0438
      \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0426\u0435\u0440\u0431\u0435\u0440\u0430."
    starCount: 5
  - message: "\u0422\u0435\u0441\u043D\u043E \u0432 \u043B\u043E\u0434\u043A\u0435,
      \u043A\u043E\u043B\u0435\u043D\u0438 \u0443\u043F\u0438\u0440\u0430\u043B\u0438\u0441\u044C
      \u0432 \u0432\u0435\u0447\u043D\u043E\u0441\u0442\u044C! \u0421\u0434\u0435\u043B\u0430\u0439\u0442\u0435
      \u0431\u0438\u0437\u043D\u0435\u0441-\u043A\u043B\u0430\u0441\u0441."
    starCount: 2
  - message: "\u0412\u043E\u0434\u0430 \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F,
      \u0430 \u043F\u043B\u0435\u0434\u043E\u0432 \u043D\u0435\u0442! \u0413\u0434\u0435
      \u0437\u0430\u0431\u043E\u0442\u0430 \u043E \u043A\u043B\u0438\u0435\u043D\u0442\u0430\u0445?"
    starCount: 2
  - message: "\u0414\u043E\u0432\u0451\u0437, \u043D\u043E \u043D\u0435 \u0434\u0430\u043B
      \u0441\u0444\u043E\u0442\u043A\u0430\u0442\u044C \u0421\u0442\u0438\u043A\u0441.
      \u0425\u043E\u0447\u0443 \u0441\u0443\u0432\u0435\u043D\u0438\u0440!"
    starCount: 3
  - message: "\u041B\u043E\u0434\u043A\u0430 \u0441\u0442\u0430\u0440\u0430\u044F
      \u2014 \u0441\u043A\u0440\u0438\u043F\u0438\u0442, \u043A\u0430\u043A \u043C\u043E\u0438
      \u043A\u043E\u0441\u0442\u0438 \u043F\u0440\u0438 \u0436\u0438\u0437\u043D\u0438!"
    starCount: 2
  - message: "\u041D\u043E\u0440\u043C, \u043D\u043E \u043E\u043D \u0438\u0433\u043D\u043E\u0440\u0438\u043B
      \u043C\u043E\u0439 \u043F\u043B\u0435\u0439\u043B\u0438\u0441\u0442. \u0413\u0434\u0435
      \u043A\u043D\u043E\u043F\u043A\u0430 \"DJ\"?"
    starCount: 3
  - message: "\u0425\u0430\u0440\u043E\u043D \u2014 \u043A\u0440\u0430\u0448 \u0437\u0430\u0433\u0440\u043E\u0431\u043A\u0438!"
    starCount: 5
  - message: "\u0412 \u043B\u043E\u0434\u043A\u0435 \u043F\u0430\u0445\u043D\u0435\u0442
      \u0441\u044B\u0440\u043E\u0441\u0442\u044C\u044E, \u0430 \u044F \u043F\u0440\u0438\u0432\u044B\u043A
      \u043A \u043B\u044E\u043A\u0441\u0443! \u041C\u0438\u043D\u0443\u0441 \u0437\u0432\u0435\u0437\u0434\u0430."
    starCount: 4
  - message: "\u041F\u043B\u044B\u043B\u0438 \u043F\u043B\u0430\u0432\u043D\u043E,
      \u043D\u043E \u0433\u0434\u0435 \u043F\u043E\u0434\u0443\u0448\u043A\u0430?
      \u0414\u0443\u0448\u0430 \u0445\u043E\u0447\u0435\u0442 \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u0430."
    starCount: 3
  - message: "\u0412\u0435\u0441\u0435\u043B\u043E, \u043D\u043E \u0425\u0430\u0440\u043E\u043D
      \u043D\u0435 \u0434\u0430\u043B \u043F\u043E\u0440\u0443\u043B\u0438\u0442\u044C.
      \u0425\u043E\u0447\u0443 \u0431\u044B\u0442\u044C \u043A\u0430\u043F\u0438\u0442\u0430\u043D\u043E\u043C!"
    starCount: 4
  - message: "\u041E\u0442\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0432\u0435\u0437\u0442\u0438
      \u0432 \u0440\u0430\u0439"
    starCount: 1
  - message: "\u041F\u043B\u044B\u043B\u0438 \u043F\u043B\u0430\u0432\u043D\u043E,
      \u043D\u043E \u043E\u043D \u043D\u0435 \u0434\u0430\u043B \u0441\u043F\u0435\u0442\u044C
      \u0448\u0430\u043D\u0441\u043E\u043D. \u0413\u0434\u0435 \u0441\u0432\u043E\u0431\u043E\u0434\u0430?"
    starCount: 3
